# 故意包含多种 BED12 格式错误的示例（用于演示“错误汇总行号并拒绝整次转换”）
# 行 2：列数不足（只有 11 列，缺少 blockStarts）
# 行 3：blockSizes / blockStarts 个数与 blockCount=3 不一致（各只有 2 项）
# 行 4：外显子重叠（块 2 起点 50 在块 1 结束位置 60 之前）
# 行 5：末个外显子没有到 end 结束（20+10=30 != 40）
# 行 6：编码区端点 thickStart=15 落在两个外显子之间的内含子缺口里
# 行 7：itemRgb 非法（分量 300 超过 255）
chr1	56	200	BAD1	0	+	100	190	0	3	44,76,21,
chr1	56	200	BAD2	0	+	100	190	0	3	44,76,	0,44,
chr1	0	100	BAD3	0	+	0	100	0	2	60,60,	0,50,
chr1	0	40	BAD4	0	+	0	40	0	2	20,10,	0,20,
chr1	0	100	BAD5	0	+	15	90	0	2	10,10,	0,90,
chr1	0	100	BAD6	0	+	10	90	300,0,0	1	100,	0,
